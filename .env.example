# Copy this file to core/.env and fill in the values.
# Never commit the real .env file. On Railway, set these as service variables instead.

# Access token: a long random secret. Every request to Ocean must send it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OCEAN_ACCESS_TOKEN=

# Which brain to use when a request does not say: cloud or local
OCEAN_DEFAULT_BRAIN=cloud

# Cloud brain: providers tried in this order. If one hits its free limit or fails,
# Ocean moves to the next. Leave a provider's key empty to skip it.
OCEAN_CLOUD_PROVIDERS=groq,openrouter,cloudflare,nvidia

# Model names exactly as listed on each provider's models page.
OCEAN_GROQ_API_KEY=
OCEAN_GROQ_MODEL=

OCEAN_OPENROUTER_API_KEY=
OCEAN_OPENROUTER_MODEL=

# Cloudflare's address includes your account ID:
# https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
OCEAN_CLOUDFLARE_BASE_URL=
OCEAN_CLOUDFLARE_API_KEY=
OCEAN_CLOUDFLARE_MODEL=

# NVIDIA's terms forbid confidential or personal data, so it is marked not
# client-safe. Chats are private by default and never go to NVIDIA; only chats
# sent with "private": false can use it.
OCEAN_NVIDIA_API_KEY=
OCEAN_NVIDIA_MODEL=

# Optional: override a provider's address. Known providers have a default.
# OCEAN_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local brain: Ollama's OpenAI-compatible endpoint on the laptop
OCEAN_LOCAL_BASE_URL=http://localhost:11434/v1
# Model name exactly as shown by the command: ollama list
OCEAN_LOCAL_MODEL=

# Seconds to wait for a brain before giving up
OCEAN_REQUEST_TIMEOUT=120
